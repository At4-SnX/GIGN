# Copie ce fichier en ".env" en local, ou renseigne ces valeurs
# dans l'onglet "Variables" de Railway (ne jamais commit le .env sur GitHub).

DISCORD_TOKEN=colle_ton_token_ici
GUILD_ID=id_du_serveur_bordeaux_rp
ARRIVAL_CHANNEL_ID=id_salon_arrivees
DEPARTURE_CHANNEL_ID=id_salon_departs

# Salon vocal où le bot reste connecté en permanence ("attente support")
SUPPORT_VOICE_CHANNEL_ID=id_salon_vocal_attente_support

# Optionnel : lien Twitch/YouTube réel pour garantir l'affichage du badge "En direct"
# (sinon le lien discord.gg par défaut est utilisé comme simple texte de statut)
STREAM_URL=
